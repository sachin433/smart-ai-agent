{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "docker compose up -d && sleep 3 && DATABASE_URL=postgresql://jobradar:jobradar@localhost:5433/jobradar drizzle-kit generate && docker exec -i smart-ai-agent-postgres-1 psql -U jobradar -d jobradar < drizzle/0000_whole_ogun.sql",
    "scan:local": "node scripts/run-local-scan.mjs",
    "scan:direct": "npx tsx scripts/run-direct-scan.ts",
    "scan:cron": "bash scripts/cron-scan-wrapper.sh",
    "cron:install": "bash scripts/install-local-cron.sh",
    "cron:uninstall": "bash scripts/uninstall-local-cron.sh",
    "cron:run": "bash scripts/cron-run-now.sh",
    "cron:status": "launchctl print gui/$(id -u)/com.jobradar.scan 2>/dev/null || echo 'Not installed — run: npm run cron:install'",
    "jobs:purge": "npx tsx scripts/purge-irrelevant.ts",
    "discover:companies": "npx tsx scripts/discover-companies.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.39.3",
    "next": "^15.1.6",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
