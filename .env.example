# Neon Postgres (free tier via Vercel Marketplace: vercel install neon)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth — single-user password for dashboard
APP_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=generate-a-random-32-char-string

# Cron / worker protection
CRON_SECRET=generate-another-random-string
WORKER_SECRET=generate-yet-another-random-string

# Optional: Resend email digest (free tier: 3000 emails/month)
# Skip these to use dashboard-only mode with zero email setup.
RESEND_API_KEY=
NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=onboarding@resend.dev

# App URL (set after Vercel deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000
